runners:
  local:
    load: galaxy.jobs.runners.local:LocalJobRunner
    workers: 4
{% if _galaxy_has_pulsar_rest %}
  pulsar:
    load: galaxy.jobs.runners.pulsar:PulsarRESTJobRunner
{% endif %}
{% for relay in _galaxy_pulsar_relay_configs %}
{% set relay_name = relay.name | default(relay.relay_url | replace('https://', '') | replace('http://', '') | replace('.', '-') | replace('/', '-') | replace(':', '-')) %}
  # Pulsar relay (message queue) runner for remote_{{ relay_name }}. The relay credentials
  # are runner parameters, so every relay connection gets its own runner. In Galaxy 26.0 the
  # MQ runner ignores a destination url: Pulsar reaches Galaxy's /api/ via galaxy_url.
  pulsar_relay_{{ relay_name }}:
    load: galaxy.jobs.runners.pulsar:PulsarMQJobRunner
    relay_url: {{ relay.relay_url | to_json }}
    relay_username: {{ relay.relay_username | to_json }}
    relay_password: {{ relay.relay_password | string | to_json }}
{% if relay.relay_topic_prefix is defined %}
    relay_topic_prefix: {{ relay.relay_topic_prefix | string | to_json }}
{% endif %}
    galaxy_url: {{ relay.galaxy_url | default('https://' ~ _galaxy_server_fqdn) | to_json }}
{% endfor %}

execution:
  default: {{ _galaxy_default_dispatcher if _galaxy_use_interactive_tools else _galaxy_jobs_default }}
  environments:
    local:
      runner: local
      env:
        - name: PATH
          action: prepend_to
          value: "{{ galaxy_mutable_data_dir }}/shed_tools:$PATH"

    docker:
      runner: local
      docker_enabled: true
      docker_set_user:
      docker_sudo: false
      container_resolvers: # use defaults
      outputs_to_working_directory: {{ _galaxy_use_interactive_tools | bool }}
{% if _galaxy_use_interactive_tools %}
    {{ _galaxy_default_dispatcher }}:
      runner: dynamic
      type: python
      function: {{ _galaxy_default_dispatcher }}
{% endif %}

    singularity:
      runner: local
      singularity_enabled: true
      singularity_volumes: {{ apptainer_volumes | join(',') }}
      outputs_to_working_directory: {{ _galaxy_use_interactive_tools | bool }}
      container_resolvers:
        - type: cached_explicit_singularity
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/explicit/"
        - type: cached_mulled_singularity
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/mulled/"
        - type: mulled_singularity
          auto_install: False
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/mulled/"
        - type: build_mulled_singularity
          auto_install: False
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/built/"
      env:
        - name: LC_ALL
          value: C
        - name: APPTAINER_CACHEDIR
          value: /tmp/singularity
        - name: APPTAINER_TMPDIR
          value: /tmp

{% if _galaxy_has_pulsar %}
{% for pulsar in _galaxy_pulsar_configs_raw %}
{% set env_name = 'remote_' ~ (pulsar.name | default(pulsar.url | replace('https://', '') | replace('http://', '') | replace('.', '-') | replace('/', '-'))) %}

    # ── Basic (non-interactive) environment for {{ env_name }} ──────────
    {{ env_name }}_basic:
      runner: pulsar
      url: {{ pulsar.url }}
      private_token: {{ pulsar.private_token }}
      default_file_action: remote_transfer
      dependency_resolution: {{ pulsar.dependency_resolution | default('remote') }}
      manager: {{ pulsar.manager | default('_default_') }}
      cleanup_job: never
{% if pulsar.docker_enabled | default(false) | bool %}
    # ── Docker/interactive environment for {{ env_name }} ───────────────
    {{ env_name }}:
      runner: pulsar
      url: {{ pulsar.url }}
      private_token: {{ pulsar.private_token }}
      default_file_action: remote_transfer
      dependency_resolution: {{ pulsar.dependency_resolution | default('remote') }}
      manager: {{ pulsar.manager | default('_default_') }}
{% if pulsar.pulsar_root is defined %}
      jobs_directory: {{ pulsar.pulsar_root }}/jobs
      persistence_directory: {{ pulsar.pulsar_root }}/persisted_data
{% endif %}
      docker_enabled: true
      docker_set_user: {{ pulsar.docker_set_user | default('') }}
      docker_memory: "{{ pulsar.docker_memory | default('8G') }}"
      docker_sudo: false
      singularity_enabled: {{ pulsar.singularity_enabled | default(false) }}
      tmp_dir: {{ pulsar.tmp_dir | default(true) }}
      outputs_to_working_directory: {{ pulsar.outputs_to_working_directory | default(false) }}
{% if pulsar.container_resolvers is defined %}
      container_resolvers:
{% for resolver in pulsar.container_resolvers %}
        - type: {{ resolver.type }}
{% if resolver.require_container is defined %}
          require_container: {{ resolver.require_container }}
{% endif %}
{% endfor %}
{% else %}
      container_resolvers:
        - type: explicit
        - type: mulled
        - type: build_mulled
          require_container: true
{% endif %}
      container_monitor_command: {{ pulsar.container_monitor_command | default('/mnt/pulsar/venv/bin/galaxy-container-monitor') }}
      container_monitor_result: {{ pulsar.container_monitor_result | default('callback') }}
      container_monitor_get_ip_method: {{ pulsar.container_monitor_get_ip_method | default('command:echo ' ~ (pulsar.name | default(pulsar.url | replace('https://','') | replace('http://','')))) }}
{% endif %}

{% endfor %}
{% for relay in _galaxy_pulsar_relay_configs %}
{% set relay_name = relay.name | default(relay.relay_url | replace('https://', '') | replace('http://', '') | replace('.', '-') | replace('/', '-') | replace(':', '-')) %}

    # ── Pulsar relay environment for remote_{{ relay_name }} ──────────
    remote_{{ relay_name }}:
      runner: pulsar_relay_{{ relay_name }}
      jobs_directory: {{ relay.jobs_directory | to_json }}
      manager: {{ relay.manager | default('_default_') | to_json }}
      dependency_resolution: {{ relay.dependency_resolution | default('remote') | to_json }}
      default_file_action: {{ relay.default_file_action | default('remote_transfer') | to_json }}
{% if relay.docker_enabled | default(false) | bool %}
      docker_enabled: true
{% if relay.docker_set_user is defined %}
      docker_set_user: {{ relay.docker_set_user | string | to_json }}
{% else %}
      docker_set_user:
{% endif %}
      docker_memory: {{ relay.docker_memory | default('8G') | string | to_json }}
      docker_sudo: false
{% endif %}
{% if relay.singularity_enabled | default(false) | bool %}
      singularity_enabled: true
{% endif %}
{% if relay.container_resolvers is defined %}
      container_resolvers:
{% for resolver in relay.container_resolvers %}
        - type: {{ resolver.type }}
{% if resolver.require_container is defined %}
          require_container: {{ resolver.require_container }}
{% endif %}
{% endfor %}
{% elif relay.docker_enabled | default(false) | bool %}
      container_resolvers:
        - type: explicit
        - type: mulled
        - type: build_mulled
          require_container: true
{% elif relay.singularity_enabled | default(false) | bool %}
      container_resolvers:
        - type: explicit_singularity
        - type: mulled_singularity
{% endif %}
{% for key, value in relay.items() if key not in _galaxy_pulsar_relay_known_keys %}
      {{ key }}: {{ value | to_json }}
{% endfor %}
{% endfor %}
{% endif %}

tools:
  - class: local  # expression tools, upload, etc - not parameterized for remote execution
    environment: local

{% if _galaxy_has_pulsar and _galaxy_pulsar_tool_mappings | length > 0 %}
{% for tool_mapping in _galaxy_pulsar_tool_mappings %}
  - id: {{ tool_mapping.tool_id }}
    environment: {{ tool_mapping.environment }}
{% endfor %}
{% endif %}
